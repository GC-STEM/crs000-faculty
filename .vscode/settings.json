{
  "editor.rulers": [72, 80],
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "breadcrumbs.enabled": true,
  "workbench.editorAssociations": {
    "**/notes/**/*.md": "vscode.markdown.editor",
    "*.md": "vscode.markdown.preview.editor",
    "*.markdown": "vscode.markdown.preview.editor"
  },
  "files.associations": {
    "pseudocode.txt": "plaintext",
    ".gitattributes": "properties",
    ".gitignore": "properties"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.vscode": true,
    "**/.vscodeedu": true,
    "**/*.code-workspace": true
  },
  "search.exclude": {
    "**/.github": true,
    "**/.vscode": true,
    "**/.vscodeedu": true,
    "**/*.code-workspace": true
  },
  "[json]": {
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.wordWrap": "on"
  },
  "[pip-requirements]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true
  },
  "[plaintext]": {
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.quickSuggestions": {
    "strings": true,
    "comments": true,
    "other": true
    }
  },
  "[properties]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[toml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
    },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "advanced"
  },

  "python.terminal.executeInFileDir": true,

  "markdown.extension.completion.enabled": false,
  "markdown.extension.list.toggle.candidate-markers": ["*", "1."],
  "markdown.extension.preview.autoShowPreviewToSide": false,
  "markdown.extension.toc.levels": "2..2",
  "markdown.extension.toc.orderedList": true,
  "markdown.extension.toc.slugifyMode": "github",
  "markdown.extension.toc.updateOnSave": false,

  "markdown-pdf.format": "Letter",
  "markdown-pdf.convertOnSave": false,
  "markdown-pdf.highlightStyle": "github.css",
  "markdown-pdf.printBackground": true,

  "cSpell.words": []
}
